# Throwaway values for the end-to-end test only. Nothing here is a real secret.
TOKEN_ENCRYPTION_KEY=e2e-key-0123456789abcdefghijklmn
PORT=8080
ALLOWED_HOSTS=vncgw-e2e-app
# The e2e network (compose.e2e.yml), so the fixture can be kept as a profile.
ALLOWED_CIDRS=172.30.99.0/24
SESSIONS_PER_MINUTE=60
# Short, so the test can watch an idle session being closed. Every step before
# that test sends input well inside 30 seconds.
IDLE_TIMEOUT_MINUTES=0.5
RECORDING=1
LOG_LEVEL=info
VNCGW_COMMIT=e2e
