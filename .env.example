# Copy to .env and edit. Never commit .env.

# Must be EXACTLY 32 characters. Generate one with:
#   docker run --rm node:22-alpine node -e "console.log(require('crypto').randomBytes(24).toString('base64').slice(0,32))"
TOKEN_ENCRYPTION_KEY=CHANGE_ME_32_CHARACTERS_EXACTLY_

# Port inside the container. Leave it alone.
PORT=8080
# Port published on the host. Change if something else already owns it.
HOST_PORT=8088

SESSION_TTL_SECONDS=60

# --- STAGE 1: local, no login -------------------------------------------------
# Every request is treated as the same dev user. Only safe on a private LAN.
AUTH_MODE=local

# --- Free-form "connect to any IP" -------------------------------------------
# Leave ALLOWED_CIDRS empty to disable the feature entirely.
# Anything reachable from these CIDRs is reachable by anyone who gets past the
# front door, so keep the range as tight as you can live with.
ALLOWED_CIDRS=192.168.1.0/24
ALLOWED_PORTS=5900,5901

# --- [STAGE 3: CLOUDFLARE] ----------------------------------------------------
# Switch AUTH_MODE to `cloudflare` and fill these in once Access is configured.
# CF_ACCESS_TEAM_DOMAIN is the bare host, e.g. yourteam.cloudflareaccess.com
# CF_ACCESS_AUD is the Application Audience tag from the Access app's settings.
#AUTH_MODE=cloudflare
#CF_ACCESS_TEAM_DOMAIN=
#CF_ACCESS_AUD=
