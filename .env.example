# Copy to .env and edit. Never commit .env. install.sh creates and tops it up.

# Must be EXACTLY 32 characters. install.sh generates one; by hand:
#   docker run --rm node:22-alpine node -e "console.log(require('crypto').randomBytes(24).toString('base64').slice(0,32))"
TOKEN_ENCRYPTION_KEY=CHANGE_ME_32_CHARACTERS_EXACTLY_

# Port inside the container. Leave it alone.
PORT=8080
# Port published on the host. Change if something else already owns it.
HOST_PORT=8088

SESSION_TTL_SECONDS=60
# Close a desktop session after this many minutes without mouse or keyboard
# input (the browser warns first). 0 = never. Frees the desktop for others.
IDLE_TIMEOUT_MINUTES=15
# Session requests allowed per user (Access) or per address (LAN) per minute.
SESSIONS_PER_MINUTE=20

# --- Free-form "connect to any IP" -------------------------------------------
# Leave ALLOWED_CIDRS empty to disable the feature entirely. Anything in these
# ranges is reachable by anyone who gets past the front door, so keep it tight.
# create-lxc.sh sets it to the container's own subnet.
ALLOWED_CIDRS=192.168.0.0/24
ALLOWED_PORTS=5900,5901

# --- Hostnames ---------------------------------------------------------------
# IP addresses and "localhost" always work. Any other name the browser uses must
# be listed, or the request is refused with 421 -- that refusal is what stops
# DNS rebinding against a service that has no login on the LAN.
# install.sh adds the container's own hostname.
ALLOWED_HOSTS=

# --- Cloudflare Access (public hostname) -------------------------------------
# Requests for these names must carry a valid Cloudflare Access token. LAN access
# by IP is unaffected. All three go together: a name listed here without the
# team domain and audience answers 503 rather than serving a desktop.
# Set them with proxmox/update-lxc.sh --access-host/--access-team/--access-aud.
# See docs/REMOTE-ACCESS.md.
ACCESS_HOSTS=
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# --- Session recording -------------------------------------------------------
# 1 = guacd records every session into ./recordings (Guacamole protocol dumps;
# convert with guacenc). Off by default: recordings hold everything on screen.
RECORDING=0

# --- Logs --------------------------------------------------------------------
# info | warn | error | debug
LOG_LEVEL=info
# Docker log driver. Empty means "local". install.sh sets journald when the
# container runs systemd-journald, so logs reach VictoriaLogs via rsyslog.
LOG_DRIVER=
